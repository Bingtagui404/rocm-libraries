    EXPECT_EQ(tensors[{{ loop.index0 }}]->getData().uid, {{ uid_const }});
{% else %}
    EXPECT_EQ(tensors[{{ loop.index0 }}]->getData().uid, {{ op.test_data.tensor_uids.get(tf.name, loop.index) }});
{% endif %}
{% endfor %}
}

TEST_F(Test{{ op.name }}OperationFromNode, BuildNodeRoundTrip)
{
    auto node = createStandardNode();
    auto desc = {{ op.class_name }}::fromNode(node, _tensorMap);

    auto rebuiltNode = desc->buildNode();
    ASSERT_NE(rebuiltNode, nullptr);
{% if op.has_compute_data_type %}
    ASSERT_EQ(rebuiltNode->compute_data_type, DataType::FLOAT);
{% endif %}
    ASSERT_EQ(rebuiltNode->attributes.type, NodeAttributes::{{ op.node_attributes_union_member }});

    const auto* rebuiltAttrs = rebuiltNode->attributes.As{{ op.fbs_table }}();
    ASSERT_NE(rebuiltAttrs, nullptr);
{% for tf in op.tensor_fields %}
{% if op.test_data.constants_include %}
{% set uid_const = "K_TENSOR_" ~ (tf.name | upper) ~ "_UID" %}
    EXPECT_EQ(rebuiltAttrs->{{ tf.uid_field }}, {{ uid_const }});
{% else %}
    EXPECT_EQ(rebuiltAttrs->{{ tf.uid_field }}, {{ op.test_data.tensor_uids.get(tf.name, loop.index) }});
{% endif %}
{% endfor %}
{% for vf in op.vector_fields %}
{% if op.test_data.constants_include %}
{% set const_name = vf.test_constant_name if vf.test_constant_name else ("K_CONV_" ~ (vf.name | upper) if "conv" in op.effective_error_label else "K_" ~ (vf.name | upper)) %}
    EXPECT_EQ(rebuiltAttrs->{{ vf.fbs_field }}, toVec({{ const_name }}));
{% else %}
    EXPECT_EQ(rebuiltAttrs->{{ vf.fbs_field }}, (std::vector<int64_t>{{ '{' }}{{ op.test_data.field_values.get(vf.name, [1, 1]) | join(', ') }}{{ '}' }}));
{% endif %}
{% endfor %}
{% for ef in op.enum_fields %}
    EXPECT_EQ(rebuiltAttrs->{{ ef.fbs_field }}, {{ ef.enum_short_type }}::{{ ef.test_enum_value }});
{% endfor %}
{% for cf in op.mode_fields %}
    EXPECT_EQ(rebuiltAttrs->{{ cf.fbs_field }}, {{ cf.enum_short_type }}::{{ cf.test_enum_value }});
{% endfor %}
}
{% if op.vector_fields or op.mode_fields %}

TEST_F(Test{{ op.name }}OperationFromNode, GetAttributeWorksAfterFromNode)
{
    auto node = createStandardNode();
    auto desc = {{ op.class_name }}::fromNode(node, _tensorMap);

{% for vf in op.vector_fields %}
    // Verify {{ vf.name }}
{% set fv = op.test_data.field_values.get(vf.name, [1, 1]) %}
    std::vector<int64_t> {{ vf.camel_name }}({{ fv | length }});
    int64_t {{ vf.camel_name }}Count = 0;
    desc->getAttribute({{ vf.attr_name }},
                       HIPDNN_TYPE_INT64,
                       {{ fv | length }},
                       &{{ vf.camel_name }}Count,
                       {{ vf.camel_name }}.data());
    ASSERT_EQ({{ vf.camel_name }}Count, {{ fv | length }});
{% if op.test_data.constants_include %}
{% set const_name = vf.test_constant_name if vf.test_constant_name else ("K_CONV_" ~ (vf.name | upper) if "conv" in op.effective_error_label else "K_" ~ (vf.name | upper)) %}
    EXPECT_EQ({{ vf.camel_name }}, toVec({{ const_name }}));
{% else %}
    EXPECT_EQ({{ vf.camel_name }}, (std::vector<int64_t>{{ '{' }}{{ fv | join(', ') }}{{ '}' }}));
{% endif %}

{% endfor %}
{% if op.has_compute_data_type %}
    // Verify compute type
    hipdnnDataType_t computeType = {};
    int64_t dtCount = 0;
    desc->getAttribute(
        {{ op.compute_data_type_attr }}, HIPDNN_TYPE_DATA_TYPE, 1, &dtCount, &computeType);
    ASSERT_EQ(computeType, HIPDNN_DATA_FLOAT);

{% endif %}
{% for cf in op.mode_fields %}
    // Verify {{ cf.name }}
    {{ cf.test_c_type }} {{ cf.camel_name }} = {};
    int64_t {{ cf.camel_name }}Count = 0;
    desc->getAttribute(
        {{ cf.attr_name }}, {{ cf.backend_type }}, 1, &{{ cf.camel_name }}Count, &{{ cf.camel_name }});
    ASSERT_EQ({{ cf.camel_name }}, {{ cf.test_backend_value }});

{% endfor %}
{% for tf in op.tensor_fields %}
    // Verify {{ tf.name }} tensor
    HipdnnBackendDescriptor* {{ tf.camel_name }}TensorDesc = nullptr;
    int64_t {{ tf.camel_name }}Count = 0;
    desc->getAttribute({{ op.operation_attr_prefix }}_{{ tf.attr_suffix }},
                       HIPDNN_TYPE_BACKEND_DESCRIPTOR,
                       1,
                       &{{ tf.camel_name }}Count,
                       static_cast<void*>(&{{ tf.camel_name }}TensorDesc));
    ASSERT_EQ({{ tf.camel_name }}Count, 1);
    ASSERT_NE({{ tf.camel_name }}TensorDesc, nullptr);
    int64_t {{ tf.camel_name }}Uid = 0;
    int64_t {{ tf.camel_name }}UidCount = 0;
    {{ tf.camel_name }}TensorDesc->getAttribute(
        HIPDNN_ATTR_TENSOR_UNIQUE_ID, HIPDNN_TYPE_INT64, 1, &{{ tf.camel_name }}UidCount, &{{ tf.camel_name }}Uid);
{% if op.test_data.constants_include %}
{% set uid_const = "K_TENSOR_" ~ (tf.name | upper) ~ "_UID" %}
    EXPECT_EQ({{ tf.camel_name }}Uid, {{ uid_const }});
{% else %}
    EXPECT_EQ({{ tf.camel_name }}Uid, {{ op.test_data.tensor_uids.get(tf.name, loop.index) }});
{% endif %}

{% endfor %}
{% if op.operation_type_enum %}
    // Verify operation type
    hipdnnOperationType_t opType = HIPDNN_OPERATION_TYPE_NOT_SET;
    int64_t opTypeCount = 0;
    desc->getAttribute(
        HIPDNN_ATTR_OPERATION_TYPE_EXT, HIPDNN_TYPE_OPERATION_TYPE_EXT, 1, &opTypeCount, &opType);
    ASSERT_EQ(opTypeCount, 1);
    EXPECT_EQ(opType, {{ op.operation_type_enum }});
{% endif %}
}
{% endif %}

TEST_F(Test{{ op.name }}OperationFromNode, NamePreservedFromNode)
{
    auto node = createStandardNode();
    node.name = "test_{{ op.name | lower }}_1";

    auto desc = {{ op.class_name }}::fromNode(node, _tensorMap);

    int64_t count = 0;
    desc->getAttribute(HIPDNN_ATTR_OPERATION_NAME_EXT, HIPDNN_TYPE_CHAR, 0, &count, nullptr);
    ASSERT_EQ(count, static_cast<int64_t>(std::string("test_{{ op.name | lower }}_1").size() + 1));

    std::vector<char> buffer(static_cast<size_t>(count));
    int64_t actualCount = 0;
    desc->getAttribute(
        HIPDNN_ATTR_OPERATION_NAME_EXT, HIPDNN_TYPE_CHAR, count, &actualCount, buffer.data());
    EXPECT_STREQ(buffer.data(), "test_{{ op.name | lower }}_1");
}

TEST_F(Test{{ op.name }}OperationFromNode, EmptyNamePreservedFromNode)
{
    auto node = createStandardNode();
    auto desc = {{ op.class_name }}::fromNode(node, _tensorMap);

    int64_t count = 0;
    desc->getAttribute(HIPDNN_ATTR_OPERATION_NAME_EXT, HIPDNN_TYPE_CHAR, 0, &count, nullptr);
    EXPECT_EQ(count, 1);
}

TEST_F(Test{{ op.name }}OperationFromNode, BuildNodePreservesName)
{
    auto node = createStandardNode();
    node.name = "test_build_name";

    auto desc = {{ op.class_name }}::fromNode(node, _tensorMap);
    auto rebuiltNode = desc->buildNode();

    ASSERT_NE(rebuiltNode, nullptr);
    EXPECT_EQ(rebuiltNode->name, "test_build_name");
}
